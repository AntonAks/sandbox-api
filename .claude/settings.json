{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/credentials.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/event-logger.py" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/event-logger.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/event-logger.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/event-logger.py" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/event-logger.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.py) uvx --quiet ruff format \"$f\" && uvx --quiet ruff check --fix \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "ruff format/check"
          }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/event-logger.py" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/block-git-mutations.py" },
          { "type": "command", "command": "python3 .claude/scripts/block-dangerous-commands.py" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/scripts/event-logger.py" }
        ]
      }
    ]
  }
}
